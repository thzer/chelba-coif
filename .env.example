# Copiez ce fichier en .env.local et remplissez les valeurs.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique du site, sans slash final (utilisée pour le SEO : sitemap, robots, Open Graph).
# À changer quand le client passe sur son propre nom de domaine.
NEXT_PUBLIC_SITE_URL=https://chelba-coif-six.vercel.app

# Notifications push vers le téléphone du barbier (Admin > Paramètres > Notifications).
# Générer les clés VAPID une fois : npx web-push generate-vapid-keys
# Le secret doit être identique à celui stocké dans Supabase Vault (booking_webhook_secret).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
BOOKING_WEBHOOK_SECRET=
