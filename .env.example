# Copiez ce fichier en .env.local et remplissez les valeurs.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique du site, sans slash final (utilisée pour le SEO : sitemap, robots, Open Graph).
# À changer quand le client passe sur son propre nom de domaine.
NEXT_PUBLIC_SITE_URL=https://chelba-coif-six.vercel.app
